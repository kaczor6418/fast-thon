rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /groceryLists/{listId} {
      // Anyone can read the shopping list
      allow read: if true;
      
      // Prevent the write if the resulting document has more than 12 items
      allow create, update: if request.resource.data.items.size() <= 12;
      
      allow delete: if true;
    }
    
  }
}